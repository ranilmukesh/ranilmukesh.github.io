---
const { title = "Ranil Mukesh | Architecting Autonomous Intelligence" } = Astro.props;
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="description" content="Ranil Mukesh - Co-Founder & CTO | PhobosQ & k22.ai. Architecting the infrastructure for autonomous enterprise intelligence." />
    <title>{title}</title>
    <ViewTransitions />
    
    <!-- KaTeX CSS for Math Rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous">
    
    <!-- Theme Script - runs BEFORE page renders to prevent flash -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var setting = (stored === 'light' || stored === 'dark' || stored === 'system') ? stored : 'system';
          var isDark = setting === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : setting === 'dark';
          var effectiveTheme = isDark ? 'dark' : 'light';
          
          document.documentElement.setAttribute('data-theme', effectiveTheme);
          document.documentElement.setAttribute('data-theme-setting', setting);
        } catch(e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-theme-setting', 'system');
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    
    <!-- Theme persistence script for ViewTransitions and System Sync -->
    <script>
      function syncTheme() {
        try {
          const stored = localStorage.getItem('theme');
          const setting = (stored === 'light' || stored === 'dark' || stored === 'system') ? stored : 'system';
          const isDark = setting === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : setting === 'dark';
          const effectiveTheme = isDark ? 'dark' : 'light';
          
          document.documentElement.setAttribute('data-theme', effectiveTheme);
          document.documentElement.setAttribute('data-theme-setting', setting);
        } catch(e) {}
      }

      // Sync theme state on page load and astro navigation
      syncTheme();
      
      // Preserve theme state during View Transitions swap
      document.addEventListener('astro:before-swap', (e) => {
        const theme = document.documentElement.getAttribute('data-theme') || 'light';
        const setting = document.documentElement.getAttribute('data-theme-setting') || 'system';
        e.newDocument.documentElement.setAttribute('data-theme', theme);
        e.newDocument.documentElement.setAttribute('data-theme-setting', setting);
      });
      
      document.addEventListener('astro:page-load', syncTheme);

      // System preference live listener
      if (typeof window !== 'undefined' && window.matchMedia) {
        const darkMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const handleSystemThemeChange = () => {
          const stored = localStorage.getItem('theme') || 'system';
          if (stored === 'system') {
            syncTheme();
            window.dispatchEvent(new CustomEvent('theme-change'));
          }
        };

        try {
          darkMediaQuery.removeEventListener('change', handleSystemThemeChange);
        } catch(e) {}
        darkMediaQuery.addEventListener('change', handleSystemThemeChange);
      }
    </script>
    
    <!-- Mermaid.js for Chart Rendering -->
    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
      mermaid.initialize({ startOnLoad: false, theme: 'base' });
      
      document.addEventListener('astro:page-load', () => {
        const blocks = document.querySelectorAll('.mermaid, pre > code.language-mermaid');
        blocks.forEach((block) => {
          if (block.tagName.toLowerCase() === 'code') {
            const container = document.createElement('div');
            container.className = 'mermaid';
            container.innerHTML = block.textContent;
            if (block.parentElement.tagName.toLowerCase() === 'pre') {
              block.parentElement.replaceWith(container);
            } else {
              block.replaceWith(container);
            }
          }
        });
        mermaid.run();
      });
    </script>
  </body>
</html>

<style>
  body {
    padding-top: 70px; /* Space for fixed header */
  }
  
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
